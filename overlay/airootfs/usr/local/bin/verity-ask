SYSTEM_PROMPT = """You are Verity, the friendly assistant built into Verity OS, an Arch-based Linux distribution.
Be concise (under about 150 words) and clear; many users are new to Linux.
When commands are needed, put each step in a ```bash fenced block and briefly say what it does.
Prefer Verity commands over raw pacman: verity install/remove/update/search/doctor/clean/history/rollback.
Never suggest destructive commands (rm -rf, dd, mkfs, partitioning) unless the user explicitly asked, and explain the risk first.
If you are not sure, say so instead of guessing. Reply in the same language the user writes in."""

DANGEROUS = [
    r"\brm\s+-[a-zA-Z]*[rf]", r"\bdd\s+.*of=/dev/", r"\bmkfs", r"\bwipefs",
    r"\b(fdisk|parted|sgdisk|cfdisk)\b", r">\s*/dev/(sd|nvme|vd)", r"chmod\s+-R\s+777",
    r"(curl|wget)[^|]*\|\s*(sudo\s+)?(ba)?sh", r"pacman\s+.*-R[a-z]*dd", r":\(\)\s*\{",
]

USE_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def c(code, text):
    return f"\033[{code}m{text}\033[0m" if USE_COLOR else text


class AIError(Exception):
    pass


# =============================================================== config
def load_conf():
    conf = {}
    for path in (SYS_CONF, USER_CONF):
        try:
            with open(path) as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        k, v = line.split("=", 1)
                        conf[k.strip()] = v.strip().strip("\"'")
        except OSError:
            pass
    for k in ("ANTHROPIC_API_KEY", "VERITY_AI_MODEL", "VERITY_AI_BACKEND", "VERITY_LOCAL_MODEL"):
        if os.environ.get(k):
            conf[k] = os.environ[k]
    return conf


def save_conf(updates):
    conf = {}
    try:
        with open(USER_CONF) as f:
            for line in f:
                if "=" in line and not line.lstrip().startswith("#"):
                    k, v = line.strip().split("=", 1)
                    conf[k] = v
    except OSError:
        pass
    conf.update(updates)
    os.makedirs(os.path.dirname(USER_CONF), mode=0o700, exist_ok=True)
    fd = os.open(USER_CONF, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        for k, v in conf.items():
            f.write(f"{k}={v}\n")


def setup_cloud():
    print(c("33;1", "Cloud AI setup (optional)"))
    print("Verity already works without this. If you want Claude's cloud answers too,")
    print("paste an Anthropic API key (console.anthropic.com; billed separately).\n")
    try:
        key = getpass.getpass("API key (hidden, empty to cancel): ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return 1
    if not key:
        print("Nothing saved.")
        return 1
    save_conf({"ANTHROPIC_API_KEY": key})
    print(f"Saved to {USER_CONF} (readable only by you).")
    return 0


# =============================================================== system context
def sh(cmd, limit=600):
    try:
        out = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return ""
    return out.strip()[:limit]


def gather_context():
    failed = sh("systemctl --failed --no-legend --plain 2>/dev/null | head -n 8")
    return "\n".join([
        "OS: " + (sh("grep -m1 PRETTY_NAME /etc/os-release | cut -d= -f2- | tr -d '\"'") or "Verity OS"),
        "Kernel: " + sh("uname -r"),
        "Desktop: " + (os.environ.get("XDG_CURRENT_DESKTOP") or "none/tty")
        + " (" + (os.environ.get("XDG_SESSION_TYPE") or "unknown") + ")",
        "Root disk: " + sh("df -h / | tail -n 1"),
        "Memory: " + sh("free -h | sed -n 2p"),
        "Failed services: " + (failed.replace("\n", "; ") if failed else "none"),
    ])


def mem_gb():
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    return int(line.split()[1]) / 1048576
    except OSError:
        pass
    return 4.0


