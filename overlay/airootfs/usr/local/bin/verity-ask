# ---- matching ---------------------------------------------------------------
_STOP = set("""a an the i is are am to do does did how can could would what why my me it of on in for and or with
this that when where which be get make not no please want need there some any you your have has had was were
just really very also so if then than too into out up down over again""".split())


def _norm(s):
    return s.lower().replace("wi-fi", "wifi").replace("wi fi", "wifi").replace("'", "").replace("\u2019", "")


def _stem(w):
    if len(w) > 5 and w.endswith("ing"):
        return w[:-3]
    if len(w) > 4 and w.endswith("ed"):
        return w[:-2]
    if len(w) > 3 and w.endswith("s") and not w.endswith("ss"):
        return w[:-1]
    return w


def _toks(s):
    return [_stem(t) for t in re.findall(r"[a-z0-9]+(?:[-+.][a-z0-9]+)*", _norm(s)) if t not in _STOP]


def _match(a, b):
    return a == b or (min(len(a), len(b)) >= 4 and (a.startswith(b) or b.startswith(a)))


for _e in BRAIN:
    _e["_keys"] = [_toks(k) for k in _e["keys"]]
    _e["_title"] = _toks(_e["title"])
_VOCAB = sorted({t for e in BRAIN for k in e["_keys"] for t in k})


def _fix_typos(qtoks):
    out = []
    for t in qtoks:
        if len(t) >= 4 and not any(_match(t, v) for v in _VOCAB):
            close = difflib.get_close_matches(t, _VOCAB, n=1, cutoff=0.8)
            t = close[0] if close else t
        out.append(t)
    return out


def brain_rank(question):
    q = _fix_typos(_toks(question))
    has = lambda t: any(_match(t, x) for x in q)
    scored = []
    for e in BRAIN:
        s = 0.0
        for k in e["_keys"]:
            if len(k) == 1:
                s += 1.5 if has(k[0]) else 0
            elif k and all(has(t) for t in k):
                s += 3
        s += 0.5 * sum(1 for t in e["_title"] if has(t))
        scored.append((s, e))
    scored.sort(key=lambda x: -x[0])
    return scored


def brain_answer(question):
    ranked = brain_rank(question)
    top, best = ranked[0]
    second = ranked[1][0]
    if top >= 2.0 or (top >= 1.5 and top - second >= 1.0):   # clear single-keyword match
        text = best["text"]
        rel = [e["title"] for s, e in ranked[1:3] if s >= 2.0 and s >= 0.85 * top]
        if rel:
            text += "\n\n(Related: " + "; ".join(rel) + ")"
        return text
    close = [e["title"] for s, e in ranked[:3] if s > 0] or [e["title"] for e in BRAIN[1:4]]
    return ("I'm not sure about that one - I'm the built-in helper, so my knowledge is limited.\n"
            "Closest topics: " + "; ".join(close) + ".\n"
            "Try rephrasing, run `verity doctor`, or install the smarter local AI:  verity ask --install-ai")


def brain_notes(question, n=2):
    return [e for s, e in brain_rank(question)[:n] if s >= 2.0]


# =============================================================== local AI (Ollama)
def _http(url, payload=None, timeout=5):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(url, data=data, headers={"content-type": "application/json"})
    return urllib.request.urlopen(req, timeout=timeout)


def ollama_models():
    """List of installed model names; None when the Ollama server isn't running."""
    try:
        with _http(OLLAMA + "/api/tags", timeout=1.5) as r:
            return [m.get("name", "") for m in json.load(r).get("models", [])]
    except Exception:
        return None


def pick_local_model(conf, models):
    want = conf.get("VERITY_LOCAL_MODEL")
    if want and want in models:
        return want
    for p in PREFER:
        if p in models:
            return p
    return models[0]


def ask_local(model, system, messages):
    payload = {"model": model, "stream": True,
               "messages": [{"role": "system", "content": system}] + messages,
               "options": {"temperature": 0.3, "num_predict": 500, "num_ctx": 4096}}
    out = []
    try:
        with _http(OLLAMA + "/api/chat", payload, timeout=600) as r:
            for line in r:
                if not line.strip():
                    continue
                chunk = json.loads(line)
                if chunk.get("error"):
                    raise AIError(chunk["error"])
                piece = chunk.get("message", {}).get("content", "")
                if piece:
                    out.append(piece)
                    print(piece, end="", flush=True)
                if chunk.get("done"):
                    break
    except urllib.error.HTTPError as e:
        raise AIError(f"local AI error {e.code} (is the model installed? verity ask --install-ai)")
    except (urllib.error.URLError, OSError) as e:
        raise AIError(f"local AI not reachable: {e}")
    print()
    text = "".join(out).strip()
    if not text:
        raise AIError("local AI returned nothing")
    return text


def _sudo(cmd):
    return subprocess.run(cmd if os.geteuid() == 0 else ["sudo"] + cmd)


def install_ai(conf):
    print(c("33;1", "Install the local Verity AI"))
    if os.path.isdir("/run/archiso"):
        print("You're in the live installer, where everything lives in RAM and is lost on reboot.")
        print("Install Verity OS to your disk first, then run:  verity ask --install-ai")
        return 1
    ram = mem_gb()
    _, model, size = [t for t in LOCAL_TIERS if ram >= t[0]][-1]
    print(f"\nThis computer has about {ram:.1f} GB of RAM, so I'd pick the model:  {c('1', model)}")
    print(f"  - one-time download: about {size} (plus ~13 MB for the Ollama program)")
    print("  - runs on your own computer: free, private, no account, no API key")
    print("  - on older computers answers take a few seconds to appear")
    print("  - the built-in helper keeps working either way\n")
    try:
        if input("Download and install now? [Y/n] ").strip().lower() not in ("", "y", "yes"):
            print("Cancelled.")
            return 0
    except (EOFError, KeyboardInterrupt):
        print()
        return 1
    try:
        urllib.request.urlopen("https://archlinux.org", timeout=6)
    except Exception:
        print(c("31", "No internet connection. Connect first (verity ask \"connect to wifi\"), then try again."))
        return 1
    if _sudo(["pacman", "-S", "--needed", "--noconfirm", "ollama"]).returncode != 0:
        print(c("31", "Could not install Ollama."))
        return 1
    _sudo(["systemctl", "enable", "--now", "ollama"])
    print("Waiting for the AI service to start...", end="", flush=True)
    for _ in range(30):
        if ollama_models() is not None:
            break
        time.sleep(1)
        print(".", end="", flush=True)
    print()
    if ollama_models() is None:
        print(c("31", "The AI service didn't start. Check: systemctl status ollama"))
        return 1
    print(f"Downloading {model} ...")
    if subprocess.run(["ollama", "pull", model]).returncode != 0:
        print(c("31", "Model download failed. Run `verity ask --install-ai` again to resume."))
        return 1
    save_conf({"VERITY_LOCAL_MODEL": model, "VERITY_AI_BACKEND": "auto"})
    print(c("32;1", "\nDone.") + f" Verity now answers with {model} running on this computer.")
    print('Try:  verity ask "why is my computer slow?"')
    return 0


# =============================================================== cloud AI (optional)
def call_api(key, model, system, messages):
    body = json.dumps({"model": model, "max_tokens": 1500, "system": system, "messages": messages}).encode()
    req = urllib.request.Request(API_URL, data=body, headers={
        "content-type": "application/json", "x-api-key": key, "anthropic-version": "2023-06-01"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            data = json.load(r)
    except urllib.error.HTTPError as e:
        if e.code == 401:
            raise AIError("the API key was rejected (verity ask --setup)")
        if e.code == 429:
            raise AIError("cloud AI rate limited or out of credit")
        raise AIError(f"cloud AI error {e.code}")
    except urllib.error.URLError:
        raise AIError("can't reach the cloud AI (offline?)")
    return "".join(b.get("text", "") for b in data.get("content", []) if b.get("type") == "text")


# =============================================================== running commands
def code_blocks(text):
    """Only ```bash / ```sh fenced blocks are runnable; ```text blocks are examples."""
    blocks, cur, lang = [], None, ""
    for line in text.splitlines():
        if line.strip().startswith("```"):
            if cur is None:
                cur, lang = [], line.strip()[3:].strip().lower()
            else:
                if lang in ("bash", "sh", "shell"):
                    blocks.append("\n".join(cur))
                cur = None
        elif cur is not None:
            cur.append(line)
    return blocks


def is_dangerous(cmd):
    return any(re.search(p, cmd) for p in DANGEROUS)


def tty_input(prompt):
    try:
        with open("/dev/tty", "r+") as tty:
            tty.write(prompt)
            tty.flush()
            return tty.readline().strip().lower()
    except OSError:
        return None


def offer_to_run(reply):
    for block in code_blocks(reply):
        cmd = block.strip()
        if not cmd:
            continue
        print(c("2", "\n  $ ") + cmd.replace("\n", "\n    "))
        if is_dangerous(cmd):
            print(c("31;1", "  Warning: this command looks risky."))
            ans = tty_input("  Type 'yes' to run it, anything else to skip: ")
            ok = ans == "yes"
        else:
            ans = tty_input("  Run this? [y/N/q to stop] ")
            ok = ans in ("y", "yes")
        if ans is None or ans == "q":
            return
        if ok:
            subprocess.run(["bash", "-c", cmd])


# =============================================================== answering
def header(label):
    print("\n" + c("33;1", "Verity") + c("2", f"  ({label})"))


def respond(question, brain_q, context, conf, history, backends, can_run, tip_state):
    history.append({"role": "user", "content": question})
    for b in backends:
        try:
            if b == "local":
                models = ollama_models()
                if not models:
                    continue
                model = pick_local_model(conf, models)
                notes = brain_notes(brain_q)
                system = SYSTEM_PROMPT + "\n\nSystem summary:\n" + context
                if notes:
                    system += "\n\nVerified reference notes for this OS (prefer them):\n" + \
                              "\n\n".join(f"## {n['title']}\n{n['text']}" for n in notes)
                header(f"local AI - {model}")
                reply = ask_local(model, system, history[-12:])
            elif b == "cloud":
                key = conf.get("ANTHROPIC_API_KEY")
                if not key:
                    continue
                header("cloud AI")
                reply = call_api(key, conf.get("VERITY_AI_MODEL", DEFAULT_CLOUD_MODEL),
                                 SYSTEM_PROMPT + "\n\nSystem summary:\n" + context, history[-12:])
                print(reply.strip())
            else:
                header("built-in helper")
                reply = brain_answer(brain_q)
                print(reply)
                if not tip_state["shown"] and ollama_models() is None:
                    print(c("2", "\n  Tip: for smarter answers that run free on your PC:  verity ask --install-ai"))
                    tip_state["shown"] = True
        except AIError as e:
            print(c("2", f"\n  ({b}: {e}) - trying the next helper"))
            continue
        history.append({"role": "assistant", "content": reply})
        print()
        if can_run:
            offer_to_run(reply)
        return
    history.pop()
    print(c("31", "verity: no helper available."))


def status(conf):
    models = ollama_models()
    print(c("33;1", "Verity AI status"))
    print(f"  built-in helper : {c('32', 'ready')}  ({len(BRAIN)} topics, offline)")
    if models is None:
        print("  local AI        : not running  ->  verity ask --install-ai")
    elif not models:
        print("  local AI        : Ollama running but no model  ->  verity ask --install-ai")
    else:
        print(f"  local AI        : {c('32', 'ready')}  ({pick_local_model(conf, models)})")
    cloud = c("32", "key saved") if conf.get("ANTHROPIC_API_KEY") else "not set (optional)  ->  verity ask --setup"
    print(f"  cloud AI        : {cloud}")
    return 0


def main(argv):
    can_run, show_ctx, force = True, False, None
    words = []
    for a in argv[1:]:
        if a in ("-h", "--help"):
            print(__doc__)
            return 0
        elif a == "--setup":
            return setup_cloud()
        elif a == "--install-ai":
            return install_ai(load_conf())
        elif a == "--status":
            return status(load_conf())
        elif a == "--no-run":
            can_run = False
        elif a == "--show-context":
            show_ctx = True
        elif a in ("--offline", "--local", "--cloud"):
            force = a[2:]
        else:
            words.append(a)

    context = gather_context()
    if show_ctx:
        print(context)
        return 0

    conf = load_conf()
    choice = force or conf.get("VERITY_AI_BACKEND", "auto")
    backends = {"local": ["local"], "cloud": ["cloud"], "offline": ["offline"]}.get(choice, ["local", "cloud", "offline"])
    if force in ("local", "cloud"):
        backends = [force, "offline"]

    question = " ".join(words).strip()
    piped = "" if sys.stdin.isatty() else sys.stdin.read(20000)
    brain_q = question or piped[:400]
    if piped:
        question = (question or "Explain this and tell me how to fix it.") + \
            "\n\nInput I was given:\n```\n" + piped + "\n```"

    history, tip = [], {"shown": False}
    if question:
        respond(question, brain_q, context, conf, history, backends, can_run, tip)
        return 0

    print(c("33;1", "Verity") + " is listening. Ask me anything about your system. (Ctrl-D to exit)")
    while True:
        try:
            q = input(c("33", "you> ")).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if q in ("exit", "quit"):
            return 0
        if q:
            respond(q, q, context, conf, history, backends, can_run, tip)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
