#!/usr/bin/env bash
# verity-setup-desktop <hypr|kde|none> <username> [--autologin]
#
# Run INSIDE the installed system (e.g. arch-chroot /mnt verity-setup-desktop hypr jan).
# Installs the desktop, enables the login manager and makes the system boot
# straight into a graphical login with the chosen desktop pre-selected.
set -euo pipefail

log()  { echo "[verity-setup-desktop] $*"; }
die()  { echo "[verity-setup-desktop] ERROR: $*" >&2; exit 1; }

LIST_ONLY=0
if [[ "${1:-}" == "--list" ]]; then LIST_ONLY=1; shift; fi

PROFILE="${1:-}"
USERNAME="${2:-}"
AUTOLOGIN=0
[[ "${3:-}" == "--autologin" ]] && AUTOLOGIN=1

case "$PROFILE" in
  hypr|hyprland)            PROFILE=hypr ;;
  kde|plasma|desktop)       PROFILE=kde ;;
  none|terminal|tty|"")     [[ $LIST_ONLY -eq 1 ]] && exit 0; log "terminal-only profile, nothing to do"; exit 0 ;;
  *) die "unknown profile '$PROFILE' (use hypr, kde or none)" ;;
esac

COMMON=(sddm networkmanager mesa xorg-xwayland pipewire pipewire-pulse wireplumber
        xdg-user-dirs noto-fonts ttf-dejavu qt5-wayland qt6-wayland python mpv)
HYPR=(hyprland kitty waybar wofi thunar xdg-desktop-portal-hyprland hyprpolkitagent)
KDE=(plasma-meta konsole dolphin kate)

if [[ $PROFILE == hypr ]]; then
  PKGS=("${COMMON[@]}" "${HYPR[@]}")
  SESSION_FILE="hyprland.desktop"
  SESSION_PATH="/usr/share/wayland-sessions/hyprland.desktop"
else
  PKGS=("${COMMON[@]}" "${KDE[@]}")
  SESSION_FILE="plasma.desktop"
  SESSION_PATH="/usr/share/wayland-sessions/plasma.desktop"
fi

# --list: just print the package names (used by verity-install for sizing)
if [[ $LIST_ONLY -eq 1 ]]; then printf '%s\n' "${PKGS[@]}"; exit 0; fi

[[ $EUID -eq 0 ]] || die "must run as root (inside the installed system)"
id "$USERNAME" &>/dev/null || die "user '$USERNAME' does not exist yet; create it before running this"

log "installing packages for profile: $PROFILE"
pacman -S --needed --noconfirm "${PKGS[@]}"

[[ -f $SESSION_PATH ]] || log "WARNING: $SESSION_PATH not found; check the package installed correctly"

# ---- Hyprland starter config -------------------------------------------------
# Hyprland (>= 0.57) loads ~/.config/hypr/hyprland.lua by default; the legacy
# .conf format is ignored unless passed with --config, and this build's conf
# parser rejects even the old starter file. The lua template ships at
# /usr/share/verity/hyprland.lua (copied in by verity-install).
install_hypr_config() {
  local dest="$1" src
  [[ -f "$dest/hyprland.lua" ]] && return 0
  mkdir -p "$dest"
  src="$(find /usr/share/verity -maxdepth 1 -name hyprland.lua 2>/dev/null | head -n1 || true)"
  if [[ -z "$src" ]]; then
    log "WARNING: /usr/share/verity/hyprland.lua not found; Hyprland will generate a default config on first start"
    return 0
  fi

  local layout="us"
  if [[ -f /etc/vconsole.conf ]]; then
    layout="$(sed -n 's/^KEYMAP=//p' /etc/vconsole.conf | head -n1 | cut -d- -f1)"
    layout="${layout:-us}"
    [[ $layout == uk ]] && layout="gb"
  fi

  cp "$src" "$dest/hyprland.lua"
  sed -i -E "s/(kb_layout[[:space:]]*=[[:space:]]*)\"us\"/\1\"$layout\"/" "$dest/hyprland.lua"
}

# ---- waybar theme ------------------------------------------------------------
install_waybar_config() {
  local dest="$1"
  [[ -f "$dest/config.jsonc" ]] && return 0
  mkdir -p "$dest"
  if [[ -f /usr/share/verity/waybar/config.jsonc ]]; then
    cp /usr/share/verity/waybar/config.jsonc "$dest/config.jsonc"
  fi
  if [[ -f /usr/share/verity/waybar/style.css ]]; then
    cp /usr/share/verity/waybar/style.css "$dest/style.css"
  fi
}

if [[ $PROFILE == hypr ]]; then
  log "writing Hyprland config"
  install_hypr_config /etc/skel/.config/hypr
  install_waybar_config /etc/skel/.config/waybar
  HOME_DIR="$(getent passwd "$USERNAME" | cut -d: -f6)"
  install_hypr_config "$HOME_DIR/.config/hypr"
  install_waybar_config "$HOME_DIR/.config/waybar"
  chown -R "$USERNAME:$(id -gn "$USERNAME")" "$HOME_DIR/.config"
fi

# ---- login manager + boot target --------------------------------------------
log "configuring SDDM"
mkdir -p /etc/sddm.conf.d
{
  echo "[General]"
  echo "Numlock=on"
  if [[ $AUTOLOGIN -eq 1 ]]; then
    echo
    echo "[Autologin]"
    echo "User=$USERNAME"
    echo "Session=$SESSION_FILE"
    echo "Relogin=false"
  fi
} > /etc/sddm.conf.d/10-verity.conf

# Pre-select the right session and user on the login screen
mkdir -p /var/lib/sddm
cat > /var/lib/sddm/state.conf <<EOF
[Last]
Session=$SESSION_FILE
User=$USERNAME
EOF
chown -R sddm:sddm /var/lib/sddm 2>/dev/null || true

log "enabling services and graphical boot target"
systemctl enable sddm.service
systemctl enable NetworkManager.service
systemctl set-default graphical.target

log "done: the installed system will boot into $PROFILE"
