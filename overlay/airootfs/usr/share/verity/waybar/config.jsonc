{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": ["hyprland/workspaces"],
  "modules-right": ["cpu", "memory", "network", "clock", "battery"],
  "cpu": {
    "interval": 5,
    "format": "CPU {usage}%"
  },
  "memory": {
    "interval": 5,
    "format": "MEM {usage}%"
  },
  "network": {
    "interval": 5,
    "format-wifi": "WiFi {ipaddr}",
    "format-ethernet": "ETH {ipaddr}",
    "format-disconnected": "offline"
  },
  "clock": {
    "interval": 30,
    "format": "{:%H:%M}"
  },
  "battery": {
    "interval": 30,
    "format": "BAT {capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "active-only": false
  }
}
